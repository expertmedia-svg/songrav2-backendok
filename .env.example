PORT=3000
JWT_SECRET=change-me-in-production

# IA
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# OTP SMS réel Orange Burkina Faso (production)
SMS_PROVIDER=orange
ORANGE_SMS_CLIENT_ID=your-orange-client-id
ORANGE_SMS_CLIENT_SECRET=your-orange-client-secret
ORANGE_SMS_SENDER_ADDRESS=tel:+2260000
# Facultatif : seulement après validation/whitelist par Orange (11 caractères max)
ORANGE_SMS_SENDER_NAME=SONGRA
# Ne jamais activer en production. En local seulement, le code est écrit dans les logs.
OTP_DEV_MODE=false

# Fichiers et CORS
UPLOAD_DIR=uploads
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Base de donnees si necessaire
DATABASE_URL=sqlite:///./resolvehub.db

# Paiements YengaPay (secrets uniquement sur le serveur)
YENGAPAY_BASE_URL=https://api.yengapay.com/api/v1
YENGAPAY_PROJECT_ID=58165
YENGAPAY_ORGANIZATION_ID=your-yengapay-organization-id
YENGAPAY_API_KEY=your-yengapay-secret-api-key
YENGAPAY_WEBHOOK_SECRET=your-yengapay-webhook-secret
YENGAPAY_RETURN_URL=https://zaamabackend.yingr-ai.com/api/payments/yengapay/return
# Voice Alert foundations (simulation only)
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ALERT_CLUSTER_WINDOW_DAYS=7
ALERT_CLUSTER_RADIUS_KM=20
CAMPAIGN_SECOND_APPROVAL_RECIPIENTS=500
CAMPAIGN_SECOND_APPROVAL_RADIUS_KM=50
CAMPAIGN_SECOND_APPROVAL_BUDGET=50000
MOCK_VOICE_UNIT_COST=0
MOCK_WORKER_BATCH_SIZE=25
MOCK_WORKER_POLL_SECONDS=5
